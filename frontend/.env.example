# Copy to .env.local and fill in. These are read server-side only (by the
# /api/backend proxy route), so they're never sent to the browser — set them
# as regular runtime environment variables on your deployment platform.

# Base URL of the backend API, no trailing slash.
BACKEND_URL=

# API key printed by backend/scripts/seed_tenant (or your tenant's key).
BACKEND_API_KEY=
