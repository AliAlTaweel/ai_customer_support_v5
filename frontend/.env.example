# Copy to .env.local and fill in. Next.js inlines NEXT_PUBLIC_* vars at build
# time, so on Vercel (or any host) these must be set as project environment
# variables before the build runs, not just at runtime.

# Base URL of the backend API, no trailing slash.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# API key printed by backend/scripts/seed_tenant (or your tenant's key).
NEXT_PUBLIC_API_KEY=
