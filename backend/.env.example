# Environment
ENVIRONMENT=development
BACKEND_DEBUG=true
BACKEND_PORT=8000

# MongoDB (required) -- needs an Atlas cluster for kb_vector_index (vector search)
MONGODB_URL=
MONGODB_DATABASE_NAME=ai_customer_support_v5

# Gemini AI (required)
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Shopify integration (optional -- only needed if a tenant connects a shop)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_TOKEN_ENCRYPTION_KEY=

# Ecommerce demo shop integration (optional -- single shared tenant)
ECOMMERCE_SHOP_TENANT_ID=
ECOMMERCE_SHOP_BASE_URL=
ECOMMERCE_SHOP_API_SECRET=

# CORS (production only)
FRONTEND_URL=

LOG_LEVEL=DEBUG
